# Copiez ce fichier en .env (jamais committé, cf. .gitignore) pour
# personnaliser votre installation locale sans modifier
# docker-compose.yml — cf. docs/DOCKER.md pour le détail de chaque
# variable.
#
#   cp .env.example .env

# Mot de passe PostgreSQL (backend `db`). Changez-le si vous exposez
# jamais ce service au-delà de votre machine (ce n'est pas le cas par
# défaut : `db` n'a pas de port publié vers l'hôte).
POSTGRES_PASSWORD=agoravote

# Ports HÔTE (à gauche du "host:conteneur" dans docker-compose.yml) —
# changez-les si les valeurs par défaut sont déjà utilisées par un
# autre programme ou un autre projet sur votre machine (`port is
# already allocated`, cf. docs/DOCKER.md, section Dépannage). Les
# ports CONTENEUR (3000 pour l'API, 80 pour le frontend) ne changent
# jamais, eux : ce sont des détails internes à l'image, pas une
# adresse que vous ouvrez dans un navigateur.
AGORAVOTE_API_PORT=3000
AGORAVOTE_FRONTEND_PORT=8080

# Niveau de log de l'API — cf. docs/LOGGING.md pour la syntaxe complète.
# RUST_LOG=info,agoravote_api=debug
